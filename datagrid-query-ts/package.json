{
  "name": "datagrid-query-ts",
  "version": "0.0.0",
  "description": "TypeScript query builder for data grids",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'test/pglite-test/**'",
    "test:integration": "vitest run test/pglite-test",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "datagrid",
    "query-builder",
    "sql",
    "pglite"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
